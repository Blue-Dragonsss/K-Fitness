<%-include('header.ejs')%>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div style="text-align: center;">

    <h1>F&Q</h1>

    <div class="contactlist">
        <div class="accordion">

            <div style="text-align: right; margin-right: 0vw;">
                <button onclick="writing()">글 작성하기</button>
            </div>

            <% lists.forEach(function(item){ %>

            <div class="accordion-content">

                <header>
                    <span class="title"> 문의: <%=item.idx%> </span>
                    <i class="fa-solid fa-plus"></i>
                </header>

                <p class="description">
                    <a class="i">∙ <%=item.name%><br></a>
                    <a class="i">∙ <%=item.phone%><br></a>
                    <a class="i">∙ <%=item.email%><br><br></a>
                    <%-item.memo.replaceAll("\n", "<br><br>")%>
                    <br><a class="delete" href="/contactDelete?idx=<%=item.idx%>" onclick="return confirm('정말 삭제할까요?')">[삭제]</a>
                </p>
            </div>
            
            <% }) %>

        </div>
</div>

<script src="contactList.js"></script>
<%-include('footer.ejs')%>